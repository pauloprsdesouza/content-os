  "components": {
    "schemas": {
      "CreateClaimForReviewRequest": {
        "required": [
          "statement",
          "confidence",
          "snapshotId",
          "evidenceLocator",
          "extractionMethod"
        ],
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "evidenceLocator": {
            "type": "string"
          },
          "extractionMethod": {
            "type": "string"
          }
        }
      },
      "CreateContentUnitRequest": {
        "required": [
          "title",
          "brief"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "brief": {
            "type": [
              "null",
              "string"
            ]
          },
          "queueGeneration": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CreateResearchJobRequest": {
        "required": [
          "topic",
          "scopeNotes"
        ],
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "scopeNotes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateSnapshotRequest": {
        "required": [
          "contentBase64",
          "mediaType"
        ],
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          }
        }
      },
      "CreateSourceRequest": {
        "required": [
          "location",
          "kind",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
